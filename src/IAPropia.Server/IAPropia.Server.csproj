<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.26</RuntimeFrameworkVersion>
    <RollForward>LatestPatch</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IAPropia</RootNamespace>
    <AssemblyName>IAPropia.Server</AssemblyName>
    <Product>IA propia</Product>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="RollForward" Value="LatestPatch" />
    <FrameworkReference Update="Microsoft.AspNetCore.App">
      <RuntimeFrameworkVersion>8.0.26</RuntimeFrameworkVersion>
    </FrameworkReference>
    <Content Update="appsettings.json" CopyToPublishDirectory="Always" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Always" />
    <Content Update="wwwroot/**" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
