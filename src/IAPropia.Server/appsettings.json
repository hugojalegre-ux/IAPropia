{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IAPropia": {
    "Titulo": "IA propia",
    "PuertoPreferido": 5077,
    "ProveedorPorDefecto": "ollama",
    "ModoSoloLocal": true,
    "InternetBusqueda": {
      "Habilitada": true,
      "MaxFragmentos": 4
    },
    "Chats": {
      "CarpetaPorDefecto": "principal"
    },
    "Ollama": {
      "BaseUrl": "http://127.0.0.1:11434",
      "Modelo": "llama3.2",
      "NumCtx": 8192,
      "NumPredict": 4096,
      "KeepAlive": "10m"
    },
    "OpenAiCompatible": {
      "BaseUrl": "https://api.openai.com/v1",
      "Modelo": "gpt-4o-mini",
      "ModelosSugeridos": [ "gpt-4o-mini", "gpt-4o", "gpt-4.1-mini", "gpt-3.5-turbo" ]
    },
    "Rag": {
      "CarpetaConocimiento": "conocimiento",
      "MaxFragmentos": 4,
      "MaxCaracteresPorFragmento": 2000
    },
    "Limites": {
      "MaxMensajesHistorial": 40,
      "TimeoutSegundos": 300,
      "TimeoutSegundosPesado": 1200,
      "TimeoutMaximo": 1800,
      "TimeoutBusquedaWebSegundos": 45
    },
    "Seguridad": {
      "EnlaceSoloLocalhost": true,
      "RequiereApiKey": false,
      "HeaderApiKey": "X-IAPropia-Key",
      "ValidarCloudflareAccess": false,
      "ExponerRutasEnEstado": true,
      "LimiteMensajeCaracteres": 32000,
      "MaxBodyKb": 512,
      "RateLimitChatPorMinuto": 20
    }
  }
}
