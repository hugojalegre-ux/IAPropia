{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IAPropia": {
    "Titulo": "IA propia",
    "PuertoPreferido": 5077,
    "ProveedorPorDefecto": "ollama",
    "ModoSoloLocal": true,
    "InternetBusqueda": {
      "Habilitada": true,
      "MaxFragmentos": 4
    },
    "Chats": {
      "CarpetaPorDefecto": "principal"
    },
    "Ollama": {
      "BaseUrl": "http://127.0.0.1:11434",
      "Modelo": "llama3.2"
    },
    "OpenAiCompatible": {
      "BaseUrl": "https://api.openai.com/v1",
      "Modelo": "gpt-4o-mini",
      "ModelosSugeridos": [ "gpt-4o-mini", "gpt-4o", "gpt-4.1-mini", "gpt-3.5-turbo" ]
    },
    "Rag": {
      "CarpetaConocimiento": "conocimiento",
      "MaxFragmentos": 4,
      "MaxCaracteresPorFragmento": 2000
    },
    "Limites": {
      "MaxMensajesHistorial": 40,
      "TimeoutSegundos": 120
    }
  }
}
